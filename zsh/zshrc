# Sourced from ~/.zshrc. Edit with `dots`, apply with `reload`. Cheat sheet: `cheat`.
# Profile startup: ZPROF=1 zsh -i -c exit (loads everything up front)
[[ -n $ZPROF ]] && zmodload zsh/zprof

DOTFILES="$HOME/dotfiles"
typeset -U path fpath   # no duplicate PATH entries

# Shells an AI agent drives (Cursor's agent terminal, Claude Code). These get a
# plain prompt and no pager, editor or plugin that waits for a keyboard.
[[ -n $CURSOR_AGENT || -n $CLAUDECODE || -n $AI_AGENT || -n $CODEX_SANDBOX ]] && AGENT_SHELL=1

# ── Oh My Zsh ────────────────────────────────────────────────────────────
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                       # Starship draws the prompt
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 14
HIST_STAMPS="yyyy-mm-dd"
COMPLETION_WAITING_DOTS="true"
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
YSU_MESSAGE_POSITION="after"       # you-should-use: alias tips after the output
# Completion cache in ~/.cache, not one ~/.zcompdump-<host> per machine name.
# Single-user Mac: skip the folder-permission audit compinit runs every start.
ZSH_COMPDUMP="$HOME/.cache/zsh/zcompdump-$ZSH_VERSION"
[[ -d ${ZSH_COMPDUMP:h} ]] || mkdir -p "${ZSH_COMPDUMP:h}"
ZSH_DISABLE_COMPFIX=true

# Completions shipped outside Homebrew (must be on fpath before compinit)
fpath=("$HOME/.zsh/completions" $fpath)

# fzf-tab before autosuggestions; syntax highlighting always last
plugins=(
  git           # g, gst, gco, gcm, gp, gl ... (`alias | grep git`)
  brew
  sudo          # Esc Esc: rerun last command with sudo
  extract       # extract any archive: `extract file.zip`
  copypath      # copy current dir path to clipboard
  copyfile      # copy a file's contents to clipboard
  macos         # ofd (open Finder here), cdf (cd to Finder window), quick-look
  docker
  fzf-tab
  you-should-use
  zsh-autosuggestions
  zsh-syntax-highlighting
)
[[ -n $AGENT_SHELL ]] && plugins=(git)

# ── Shell behaviour ──────────────────────────────────────────────────────
# Set before the first prompt: zsh reads the history file once rc files finish.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS
setopt SHARE_HISTORY EXTENDED_HISTORY
setopt AUTO_CD                # type a folder name to cd into it
setopt INTERACTIVE_COMMENTS   # allow # comments at the prompt

# ── Modules ──────────────────────────────────────────────────────────────
# Enough to draw the prompt, then the rest once it's on screen (later.zsh).
for f in "$DOTFILES"/zsh/{cached-init,env,prompt}.zsh; do
  source "$f"
done

later=("$ZSH/oh-my-zsh.sh" "$DOTFILES"/zsh/{toolchains,tools,aliases,functions,menu,editing,brew}.zsh)
[[ -f "$DOTFILES/zsh/local.zsh" ]] && later+=("$DOTFILES/zsh/local.zsh")   # untracked, machine-only

# Only a shell reading commands from a terminal ever gets an idle line editor.
# The rest (`zsh -i -c`, which editors use to read the environment, piped
# scripts), agent shells and profiling load everything up front.
if [[ -o zle && -o shinstdin && -t 0 && -z $AGENT_SHELL && -z $ZPROF ]]; then
  source "$DOTFILES/zsh/later.zsh"
  zsh_later $later
else
  for f in $later; do
    source "$f"
  done
fi
unset f later

[[ -n $ZPROF ]] && zprof
